# Local development (SQL Server — default when DATABASE_URL is unset)
DEBUG=True
SECRET_KEY=change-me-in-production

# Render / PostgreSQL (uncomment for local PostgreSQL testing)
# DATABASE_URL=postgres://user:password@localhost:5432/home_appliances

# Optional admin user created on deploy (Render env vars)
# ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Production site URL (set on Render after first deploy)
# SITE_URL=https://your-app.onrender.com
